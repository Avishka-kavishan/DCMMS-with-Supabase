generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RegisterOfficerTable {
  id          String                 @id @default(uuid())
  employee_no String                 @unique
  full_name   String
  email       String                 @unique
  password    String                 @default("123456")
  role        String?                @default("Register Officer")
  is_active   Boolean?               @default(true)
  created_by  String?
  created_at  DateTime?              @default(now())
  updated_at  DateTime?              @default(now()) @updatedAt
  creator     RegisterOfficerTable?  @relation("RegisterOfficerCreatedBy", fields: [created_by], references: [id])
  created     RegisterOfficerTable[] @relation("RegisterOfficerCreatedBy")

  @@map("register_officer_table")
}

model DailyMailLetterTable {
  id                              BigInt    @id @default(autoincrement())
  letter_number                   String?   @db.VarChar(100)
  ref_number                      String?   @db.VarChar(100)
  mode_of_receipt                 String?   @db.VarChar(100)
  senders_party                   String?   @db.VarChar(255)
  nature_of_letter                String?   @db.VarChar(1000)
  subject_category                String?   @db.VarChar(500)
  subject_of_letter               String?
  date_received_by_add_secretary  DateTime? @db.Date
  date_letter_handover_discipline DateTime? @db.Date
  created_at                      DateTime? @default(now())
  updated_at                      DateTime? @default(now()) @updatedAt

  @@map("daily_mail_letter_table")
}

model accused_officer_table {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accused_officer_name String                @db.VarChar(255)
  address              String?
  position             String?               @db.VarChar(150)
  date_of_birth        DateTime?             @db.Date
  nic_no               String?               @unique @db.VarChar(12)
  appointment_date     DateTime?             @db.Date
  created_at           DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?             @default(now()) @db.Timestamptz(6)
  accused_school_id    BigInt?
  accused_school_table accused_school_table? @relation(fields: [accused_school_id], references: [id], onUpdate: NoAction)
}

model accused_school_table {
  id                    BigInt                  @id @default(autoincrement())
  accused_school_name   String                  @db.VarChar(255)
  address               String?
  province              String?                 @db.VarChar(100)
  district              String?                 @db.VarChar(100)
  zone                  String?                 @db.VarChar(100)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  accused_officer_table accused_officer_table[]
}
