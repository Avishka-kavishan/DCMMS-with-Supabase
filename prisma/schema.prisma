generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RegisterOfficerTable {
  id          String                 @id @default(uuid())
  employee_no String                 @unique
  full_name   String
  email       String                 @unique
  password    String                 @default("123456")
  role        String?                @default("Register Officer")
  is_active   Boolean?               @default(true)
  created_by  String?
  created_at  DateTime?              @default(now())
  updated_at  DateTime?              @default(now()) @updatedAt
  creator     RegisterOfficerTable?  @relation("RegisterOfficerCreatedBy", fields: [created_by], references: [id])
  created     RegisterOfficerTable[] @relation("RegisterOfficerCreatedBy")

  @@map("register_officer_table")
}

model DailyMailLetterTable {
  id                              BigInt                     @id @default(autoincrement())
  letter_number                   String?                    @db.VarChar(100)
  ref_number                      String?                    @db.VarChar(100)
  mode_of_receipt                 String?                    @db.VarChar(100)
  senders_party                   String?                    @db.VarChar(255)
  nature_of_letter                String?                    @db.VarChar(1000)
  subject_category                String?                    @db.VarChar(500)
  subject_of_letter               String?
  date_received_by_add_secretary  DateTime?                  @db.Date
  date_letter_handover_discipline DateTime?                  @db.Date
  created_at                      DateTime?                  @default(now())
  updated_at                      DateTime?                  @default(now()) @updatedAt
  subject_officer_form_table      SubjectOfficerFormTable[]

  @@map("daily_mail_letter_table")
}

model accused_officer_table {
  id                                         String                                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accused_officer_name                       String                                       @db.VarChar(255)
  address                                    String?
  position                                   String?                                      @db.VarChar(150)
  date_of_birth                              DateTime?                                    @db.Date
  nic_no                                     String?                                      @db.VarChar(12)
  appointment_date                           DateTime?                                    @db.Date
  created_at                                 DateTime?                                    @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime?                                    @default(now()) @db.Timestamptz(6)
  accused_school_id                          BigInt?
  accused_school_table                       accused_school_table?                        @relation(fields: [accused_school_id], references: [id], onUpdate: NoAction)
  subject_officer_form_table                 SubjectOfficerFormTable[]
  accused_officer_subject_officer_form_table accused_officer_subject_officer_form_table[]
}

model accused_school_table {
  id                    BigInt                  @id @default(autoincrement())
  accused_school_name   String                  @db.VarChar(255)
  address               String?
  province              String?                 @db.VarChar(100)
  district              String?                 @db.VarChar(100)
  zone                  String?                 @db.VarChar(100)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  accused_officer_table accused_officer_table[]
}

model SubjectOfficerFormTable {
  id                                              BigInt                                       @id @default(autoincrement())
  daily_mail_letter_id                            BigInt?
  ref_number                                      String?                                      @db.VarChar(100)
  subject_file_no                                 String?                                      @db.VarChar(100)
  future_action                                   String?
  date_prepared_and_submitted_for_signature       DateTime?                                    @db.Date
  classification_of_complaint_letter              String?                                      @db.VarChar(100)
  name_of_the_presenting_the_complain             String?                                      @db.VarChar(255)
  address_of_the_person_presenting_the_complaint String?
  accused_officer_id                              String?                                      @db.Uuid
  accused_officer                                 accused_officer_table?                       @relation(fields: [accused_officer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  daily_mail_letter                               DailyMailLetterTable?                        @relation(fields: [daily_mail_letter_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_at                                      DateTime?                                    @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime?                                    @default(now()) @db.Timestamptz(6)
  accused_officer_subject_officer_form_table      accused_officer_subject_officer_form_table[]

  @@map("subject_officer_form_table")
}

model accused_officer_subject_officer_form_table {
  accused_officer_id      String                  @db.Uuid
  subject_officer_form_id BigInt
  accused_officer         accused_officer_table   @relation(fields: [accused_officer_id], references: [id], onDelete: Cascade)
  subject_officer_form    SubjectOfficerFormTable @relation(fields: [subject_officer_form_id], references: [id], onDelete: Cascade)

  @@id([accused_officer_id, subject_officer_form_id])
  @@map("accused_officer_subject_officer_form_table")
}

model institute_table {
  id             BigInt    @id @default(autoincrement())
  institute_name String    @db.VarChar(255)
  address        String?
  province       String?   @db.VarChar(100)
  district       String?   @db.VarChar(100)
  zone           String?   @db.VarChar(100)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@map("institute_table")
}

model commitee_table {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_no  String         @unique @db.VarChar(255)
  full_name    String         @db.VarChar(255)
  email        String?        @unique @db.VarChar(255)
  position     String?        @db.VarChar(255)
  nic_no       String?        @unique @db.VarChar(255)
  state        String?        @db.VarChar(255)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?      @default(now()) @db.Timestamptz(6)
  school_table school_table[]

  @@map("commitee_table")
}

model school_table {
  id                           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_no                  String?         @db.VarChar(255)
  member_school_name           String?         @db.VarChar(255)
  member_children_schools_name String?         @db.Text
  created_at                   DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime?       @default(now()) @db.Timestamptz(6)
  commitee_table               commitee_table? @relation(fields: [employee_no], references: [employee_no], onDelete: Cascade, onUpdate: Cascade)

  @@map("school_table")
}

model chairment_by_case {
  id         BigInt    @id @default(autoincrement())
  ref_number String?   @db.VarChar(255)
  full_name  String?   @db.VarChar(255)
  position   String?   @db.VarChar(255)
  email      String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  @@map("chairment_by_case")
}



